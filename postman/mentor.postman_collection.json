    {
      "name": "Create session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('session id is returned', function () {",
              "    pm.expect(pm.response.json().sessionId).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('sessionId', pm.response.json().sessionId);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"topic\":\"loops\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions"
          ]
